rules_version = '2';

// QUINTANA.Store — Firestore Security Rules
// Single-admin store: public reads products, only authorized admin UID can write.

service cloud.firestore {
  match /databases/{database}/documents {

    // Public products: anyone can read, only admin can write
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == 'dKGCXBrl7keYkL8qprx1TnrcHrr2';
    }
  }
}
